# =============================================================================
# Delta Bot v6 - Configuration
# =============================================================================
# Copy this file to `.env` and fill in your values.
# IMPORTANT: never commit .env to git. Add it to .gitignore.
# =============================================================================

# --- Mode -----------------------------------------------------
# true  = simulated paper trading (no real funds at risk)
# false = LIVE trading on the configured exchanges
PAPER_TRADING=true

LOG_LEVEL=INFO
MAIN_LOOP_INTERVAL_SECONDS=20

# --- Hyperliquid ----------------------------------------------
# Hyperliquid signs orders with an EVM private key (NOT a REST API key).
# You can use the same key as EVM_PRIVATE_KEY or a dedicated trading key
# pre-approved on the Hyperliquid web UI.
# HYPERLIQUID_API_SECRET = the EVM private key used to sign orders
# HYPERLIQUID_WALLET_ADDRESS = the public address of the trading account
HYPERLIQUID_API_KEY=
HYPERLIQUID_API_SECRET=
HYPERLIQUID_WALLET_ADDRESS=
HYPERLIQUID_TESTNET=true

# --- Aster ----------------------------------------------------
# REST API credentials issued from the Aster dashboard.
ASTER_API_KEY=
ASTER_API_SECRET=
ASTER_WALLET_ADDRESS=
ASTER_TESTNET=true

# --- Telegram (optional but recommended for alerts) ----------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- EVM wallet (used to read balances + sign Hyperliquid) ---
EVM_PRIVATE_KEY=
EVM_RPC_URL=https://arb1.arbitrum.io/rpc
EVM_CHAIN_ID=42161

# --- Solana wallet (read-only balance check) -----------------
SOLANA_PRIVATE_KEY=
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
